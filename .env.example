# ── Conexión con entropy-mcp-server ────────────────────────────────────────
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_: eso es deliberado.
# Next.js solo inyecta en el bundle del navegador las que lo llevan, así que
# la llave se queda en el servidor y el navegador nunca la ve.

# Dominio del backend, sin barra final y sin /api/v1
ENTROPY_API_URL=https://mcp-server-development-534053084464.us-east4.run.app

# Bearer token: el valor de INTEGRATION_API_KEY del servidor Go.
# Si esa variable no está definida allá, config.go cae a MCP_API_KEY,
# que en Cloud Run vive en el secreto mcp-apikey-development.
#
# PARA ROTARLA: cambia este valor y reinicia el proceso.
#   - local        -> editar .env.local y reiniciar `npm run dev`
#   - Vercel       -> Settings > Environment Variables, luego redeploy
#   - Cloud Run    -> gcloud run services update <svc> --update-secrets ENTROPY_API_KEY=<secreto>:latest
# No hay que tocar código: se lee en cada request, nunca se hornea en el build.
ENTROPY_API_KEY=

# Opcional: milisegundos antes de abortar una llamada al backend (default 15000)
# ENTROPY_TIMEOUT_MS=15000
